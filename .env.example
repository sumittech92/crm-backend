#super-admin-credentail
SUPERADMIN_ALLOWLIST=sumit@gmail.com|+91|9999988888,stuti@gmail.com|+91|8888899999
# Mock paper generator (school, Classes 9–12)
# Free option: Google Gemini API free tier, no card needed. Create a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: model(s) to try first, comma-separated (free models are tried after these automatically)
# GEMINI_MODEL=gemini-2.5-flash
# Optional: force the writer: gemini (free) or claude (needs ANTHROPIC_API_KEY). Default: claude if its key is set, else gemini.
# PAPER_AI=gemini
# ANTHROPIC_API_KEY=
# Papers per person per day
# MOCK_PAPER_DAILY_LIMIT_STUDENT=5
# MOCK_PAPER_DAILY_LIMIT_STAFF=20
